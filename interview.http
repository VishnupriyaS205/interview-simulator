@baseUrl = http://localhost:5000
@userId = 1
@sessionId = 21

### Signup
POST {{baseUrl}}/api/signup
Content-Type: application/json

{
  
  "fullName": "vishnu",
  "email": "vishnu@gmail.com",
  "password": "123@123"
}

### Signin
# This response sets an HttpOnly authToken cookie.
# After this request, the REST client should send that cookie automatically
# for the protected requests below.
POST {{baseUrl}}/api/signin
Content-Type: application/json

{
  "email": "vishnu@gmail.com",
  "password": "123@123"
}

### Check current logged-in user
GET {{baseUrl}}/api/me

### Sign out
POST {{baseUrl}}/api/signout

### Get fields
GET {{baseUrl}}/api/fields

### Get rounds
GET {{baseUrl}}/api/rounds

### Get questions by field and round
GET {{baseUrl}}/api/questions?fieldId=1&roundId=5
### Get interview questions
GET {{baseUrl}}/api/interview/questions?roleName=Frontend%20Developer&skill=React&difficulty=Easy

### Save interview session
POST {{baseUrl}}/api/interview/sessions
Content-Type: application/json

{
  "userId": {{userId}},
  "roleName": "Frontend Developer",
  "skill": "React",
  "difficulty": "Easy",
  "results": [
    {
      "roundId": "aptitude",
      "score": 1,
      "total": 1,
      "answers": {
        "0": "12"
      },
      "questions": [
        {
          "id": 1
        }
      ]
    }
  ]
}

### Get dashboard
GET {{baseUrl}}/api/users/{{userId}}/dashboard

### Get session history
GET {{baseUrl}}/api/users/{{userId}}/sessions

### Get one session analysis
GET {{baseUrl}}/api/users/{{userId}}/sessions/{{sessionId}}

### Get profile
GET {{baseUrl}}/api/users/{{userId}}/profile

### Update profile
PATCH {{baseUrl}}/api/users/{{userId}}/profile
Content-Type: application/json

{
  "fullName": "vishnupriya",
  "email": "vishnu@gmail.com",
  "careerGoal": "Frontend Developer",
  "level": "Beginner",
  "profilePicture": ""
}
